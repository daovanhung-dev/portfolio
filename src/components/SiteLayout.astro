---
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import AudioPlayer from './AudioPlayer.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { siteAsset, sitePath } from '../utils/paths';

interface Props {
  title: string;
  description: string;
  route?: string;
  noindex?: boolean;
}

const { title, description, route = Astro.url.pathname, noindex = false } = Astro.props;
const origin = 'https://daovanhung-dev.github.io';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const routeWithoutBase = route.startsWith(basePath + '/') || route === basePath
  ? route.slice(basePath.length) || '/'
  : route;
const canonical = new URL(sitePath(routeWithoutBase), origin).toString();
const socialImage = new URL(siteAsset('og-portfolio.png'), origin).toString();
---

<!doctype html>
<html lang="vi" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#111315" />
    <meta name="description" content={description} />
    <meta name="author" content="Đào Văn Hùng" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={siteAsset('favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="Đào Văn Hùng — Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <SiteHeader />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <AudioPlayer />
  </body>
</html>
