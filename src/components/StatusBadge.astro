---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'span'> {
  status: string;
}

const { status, ...attrs } = Astro.props;
const labels: Record<string, string> = {
  implemented: 'Đã triển khai trong mã nguồn',
  partial: 'Triển khai một phần',
  placeholder: 'Placeholder',
  'source-only': 'Mã nguồn',
  design: 'Thiết kế / bản mẫu',
  'deployed-verified': 'Đã xác minh triển khai',
  historical: 'Phiên bản lịch sử',
  learning: 'Đang học',
  planned: 'Theo lộ trình',
};
---

<span class="status-badge" data-status={status} {...attrs}>
  <span class="status-badge__dot" aria-hidden="true"></span>
  {labels[status] ?? 'Đang cập nhật'}
</span>
