---
import { evidenceLabel, publicEvidenceFor, repositoryName } from '../utils/evidence';

interface Props {
  ids: string[];
  compact?: boolean;
}

const { ids, compact = false } = Astro.props;
const refs = publicEvidenceFor(ids);
---

{refs.length > 0 && (
  <ul class:list={['evidence-list', { 'evidence-list--compact': compact }]}>
    {refs.map((ref) => (
      <li class="evidence-item">
        <div class="evidence-item__top">
          <span class="evidence-kind">{evidenceLabel(ref.kind)}</span>
        </div>
        <div class="evidence-item__links">
          {repositoryName(ref.repoId) && <span>{repositoryName(ref.repoId)}</span>}
          {ref.path && <code>{ref.path}</code>}
          {ref.url && (
            <a href={ref.url} target="_blank" rel="noreferrer">
              Xem mã nguồn <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </li>
    ))}
  </ul>
)}
