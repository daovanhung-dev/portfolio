---
import { siteAsset, sitePath } from '../utils/paths';

interface Props {
  project: {
    id: string;
    data: {
      title: string;
      category: string;
      filterGroup: string;
      summary: string;
      status: string;
      period?: string;
      stack: string[];
      featured?: boolean;
      storeUrl?: string;
      coverImage?: { file: string; alt: string; width: number; height: number };
      gallery?: { file: string; alt: string; caption: string }[];
    };
  };
}

const { project } = Astro.props;
const cover = project.data.coverImage ?? project.data.gallery?.[0];
---

<article class="project-card" data-project-card data-category={project.data.filterGroup}>
  {cover && (
    <a class="project-card__cover" href={sitePath('/projects/' + project.id)}>
      <img src={siteAsset(cover.file)} alt={cover.alt} width={project.data.coverImage?.width ?? 698} height={project.data.coverImage?.height ?? 1600} loading="lazy" decoding="async" />
    </a>
  )}
  <div class="project-card__top">
    <span class="eyebrow">{project.data.category}</span>
    {project.data.period && <span class="project-card__period">{project.data.period}</span>}
  </div>
  <h2><a href={sitePath('/projects/' + project.id)}>{project.data.title}<span aria-hidden="true"> ↗</span></a></h2>
  <p>{project.data.summary}</p>
  <div class="tag-list" aria-label="Công nghệ chính">
    {project.data.stack.slice(0, 4).map((tag) => <span class="tag">{tag}</span>)}
  </div>
  <div class="project-card__bottom">
    <div class="project-card__actions">
      <a class="text-link" href={sitePath('/projects/' + project.id)}>Xem chi tiết <span aria-hidden="true">→</span></a>
      {project.data.storeUrl && (
        <a class="text-link" href={project.data.storeUrl} target="_blank" rel="noreferrer">Google Play <span aria-hidden="true">↗</span></a>
      )}
    </div>
  </div>
</article>
