---
import StatusBadge from './StatusBadge.astro';
import { sitePath } from '../utils/paths';

interface Props {
  item: {
    id: string;
    data: {
      title: string;
      context: string;
      status: string;
      role: string;
    };
  };
}

const { item } = Astro.props;
---

<article class="case-card">
  <div class="case-card__top">
    <span class="eyebrow">Case study</span>
    <StatusBadge status={item.data.status} />
  </div>
  <h3><a href={sitePath('/case-studies/' + item.id)}>{item.data.title}<span aria-hidden="true"> ↗</span></a></h3>
  <p>{item.data.context}</p>
  <div class="case-card__bottom">
    <span>{item.data.role}</span>
    <a class="text-link" href={sitePath('/case-studies/' + item.id)}>Đọc case <span aria-hidden="true">→</span></a>
  </div>
</article>
