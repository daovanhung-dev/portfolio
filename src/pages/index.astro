---
import { getCollection } from 'astro:content';
import SiteLayout from '../components/SiteLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CaseCard from '../components/CaseCard.astro';
import { siteAsset, sitePath } from '../utils/paths';

const [profiles, allProjects, allCases] = await Promise.all([
  getCollection('profile'),
  getCollection('projects'),
  getCollection('cases'),
]);
const profile = profiles[0].data;
const featuredProjects = allProjects
  .filter((item) => item.data.featured)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999)
    || a.data.title.localeCompare(b.data.title, 'vi'));
const featuredCases = allCases
  .filter((item) => item.data.featured)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .slice(0, 3);
---

<SiteLayout title="Đào Văn Hùng — Kỹ sư phần mềm" description="Đào Văn Hùng xây dựng sản phẩm phần mềm với thế mạnh backend Python, Flutter, dữ liệu và phân tích hệ thống.">
  <section class="hero" aria-labelledby="home-title">
    <div class="hero__left">
      <span class="eyebrow">Portfolio kỹ thuật · 2026</span>
      <h1 class="hero-title" id="home-title">Đào Văn Hùng<span class="accent-text">.</span></h1>
      <p class="hero__lede">{profile.headline} {profile.supportingStatement}</p>
      <div class="hero__actions">
        <a class="button button--primary" href={sitePath('/projects')}>Xem dự án <span aria-hidden="true">→</span></a>
        <a class="button button--quiet" href={sitePath('/contact')}>Trao đổi công việc <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <aside class="hero__aside" aria-label="Hướng tập trung">
      <div class="profile-portrait-frame hero__portrait">
        <img
          class="profile-portrait"
          src={siteAsset('AVT.jpg')}
          alt="Chân dung Đào Văn Hùng"
          width="960"
          height="958"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
      <h2>Hiện tại tôi tập trung</h2>
      <p><strong>{profile.role}</strong><br />{profile.availability}</p>
      <div class="focus-stack">
        {profile.focusAreas.map((area) => <span class="focus-chip">{area}</span>)}
      </div>
      <p class="hero__aside-note">Kết hợp tư duy sản phẩm với triển khai phần mềm, từ thiết kế hệ thống đến kiểm thử.</p>
    </aside>
  </section>

  <section class="section" aria-labelledby="selected-work">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Chọn lọc</span>
        <h2 id="selected-work">Dự án tiêu biểu</h2>
        <p>Các dự án được chọn để thể hiện phần việc, lựa chọn kỹ thuật và trạng thái kiểm chứng.</p>
      </div>
      <a class="text-link" href={sitePath('/projects')}>Xem danh mục <span aria-hidden="true">→</span></a>
    </div>
    <div class="grid project-grid">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="section" aria-labelledby="case-notes">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Cách tôi làm việc</span>
        <h2 id="case-notes">Cách tôi giải quyết vấn đề</h2>
        <p>Các case đi từ bối cảnh và ràng buộc đến cách tiếp cận, lựa chọn kỹ thuật và kết quả.</p>
      </div>
      <a class="text-link" href={sitePath('/case-studies')}>Tất cả case <span aria-hidden="true">→</span></a>
    </div>
    <div class="grid case-grid">
      {featuredCases.map((item) => <CaseCard item={item} />)}
    </div>
  </section>

  <section class="section section--compact">
    <div class="contact-card">
      <div>
        <span class="eyebrow">Kết nối</span>
        <h2>Cùng trao đổi về giải pháp kỹ thuật</h2>
        <p>Liên hệ để trao đổi về cơ hội phát triển phần mềm hoặc một bài toán phù hợp với kinh nghiệm của tôi.</p>
      </div>
      <a class="button button--primary" href={sitePath('/contact')}>Liên hệ <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</SiteLayout>
