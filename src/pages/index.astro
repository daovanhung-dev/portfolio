---
import { getCollection } from 'astro:content';
import SiteLayout from '../components/SiteLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CaseCard from '../components/CaseCard.astro';
import { sitePath } from '../utils/paths';

const [profiles, allProjects, allCases] = await Promise.all([
  getCollection('profile'),
  getCollection('projects'),
  getCollection('cases'),
]);
const profile = profiles[0].data;
const featuredProjects = allProjects
  .filter((item) => item.data.featured)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'vi'))
  .slice(0, 4);
const featuredCases = allCases
  .filter((item) => item.data.featured)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .slice(0, 3);
---

<SiteLayout title="Đào Văn Hùng — Kỹ sư phần mềm" description="Hồ sơ kỹ thuật của Đào Văn Hùng: dự án, case study và giới hạn evidence được ghi rõ.">
  <section class="hero" aria-labelledby="home-title">
    <div class="hero__left">
      <span class="eyebrow">Portfolio kỹ thuật · 2026</span>
      <h1 class="hero-title" id="home-title">Đào Văn Hùng<span class="accent-text">.</span></h1>
      <p class="hero__lede">{profile.headline} {profile.supportingStatement}</p>
      <div class="hero__actions">
        <a class="button button--primary" href={sitePath('/projects')}>Xem dự án <span aria-hidden="true">→</span></a>
        <a class="button button--quiet" href={sitePath('/contact')}>Trao đổi công việc <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <aside class="hero__aside" aria-label="Hướng tập trung">
      <h2>Hiện tại tôi tập trung</h2>
      <p><strong>{profile.role}</strong><br />{profile.availability}</p>
      <div class="focus-stack">
        {profile.focusAreas.map((area) => <span class="focus-chip">{area}</span>)}
      </div>
      <p class="hero__aside-note">Vai trò, phạm vi và trạng thái được ghi theo từng nguồn; không suy diễn từ repository sang production.</p>
    </aside>
  </section>

  <section class="section" aria-labelledby="selected-work">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Chọn lọc</span>
        <h2 id="selected-work">Dự án có thể truy nguyên</h2>
        <p>Đi từ câu hỏi và phạm vi đến source, trạng thái kiểm chứng và phần còn thiếu.</p>
      </div>
      <a class="text-link" href={sitePath('/projects')}>Tất cả dự án <span aria-hidden="true">→</span></a>
    </div>
    <div class="grid project-grid">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="section" aria-labelledby="case-notes">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Cách tôi làm việc</span>
        <h2 id="case-notes">Case study và ranh giới evidence</h2>
        <p>Mỗi case cho biết điều gì đã được quan sát, điều gì do chủ sở hữu tự xác nhận và điều gì chưa có nguồn.</p>
      </div>
      <a class="text-link" href={sitePath('/case-studies')}>Tất cả case <span aria-hidden="true">→</span></a>
    </div>
    <div class="grid case-grid">
      {featuredCases.map((item) => <CaseCard item={item} />)}
    </div>
  </section>

  <section class="section section--compact">
    <div class="contact-card">
      <div>
        <span class="eyebrow">Kết nối</span>
        <h2>Muốn xem sâu hơn vào một phần việc?</h2>
        <p>Tôi có thể trao đổi về source công khai, lựa chọn kỹ thuật và những giới hạn đã ghi nhận.</p>
      </div>
      <a class="button button--primary" href={sitePath('/contact')}>Liên hệ <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</SiteLayout>
