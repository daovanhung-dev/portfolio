---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../components/SiteLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import EvidenceList from '../../components/EvidenceList.astro';
import CaseCard from '../../components/CaseCard.astro';
import { publicEvidenceFor } from '../../utils/evidence';
import { siteAsset, sitePath } from '../../utils/paths';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const relatedCases = (await getCollection('cases')).filter((item) => project.data.caseSlugs.includes(item.id));
const sourceRefs = publicEvidenceFor(project.data.evidenceIds);
const pageDescription = project.data.summary.slice(0, 155);
---

<SiteLayout title={project.data.title + ' — Đào Văn Hùng'} description={pageDescription} route={'/projects/' + project.id}>
  <div class="page-shell">
    <header class:list={['detail-header', { 'detail-header--study2work': project.data.id === 'study2work' }]}>
      <a class="eyebrow-link" href={sitePath('/projects')}>← Dự án tiêu biểu</a>
      <h1>{project.data.title}</h1>
      <p class="page-lede">{project.data.summary}</p>
      <div class="detail-header__meta">
        <span>{project.data.category}</span>
        <span>{project.data.role}</span>
        {project.data.period && <span>{project.data.period}</span>}
      </div>
      <div class="detail-header__meta">
        <StatusBadge status={project.data.status} />
        {project.data.availability !== 'unknown' && <span>Tính sẵn có: {project.data.availability}</span>}
      </div>
      {project.data.storeUrl && (
        <div class="detail-header__actions">
          <a class="button button--primary" href={project.data.storeUrl} target="_blank" rel="noreferrer">
            Tải ứng dụng trên Google Play <span aria-hidden="true">↗</span>
          </a>
        </div>
      )}
    </header>
    <div class:list={['detail-body', { 'detail-body--study2work': project.data.id === 'study2work' }]}>
      <article class:list={['prose', { 'study2work-prose': project.data.id === 'study2work' }]}>
        <Content />
        {project.data.gallery.length > 0 && (
          <section class="project-gallery" aria-labelledby="project-gallery-title">
            <div class="section-heading">
              <div>
                <span class="eyebrow">Ứng dụng Android</span>
                <h2 id="project-gallery-title">Màn hình NanoBio</h2>
              </div>
              <p>Ảnh sản phẩm từ listing Google Play.</p>
            </div>
            <div class="project-gallery__grid">
              {project.data.gallery.map((image) => (
                <figure>
                  <img data-project-screenshot src={siteAsset(image.file)} alt={image.alt} width="698" height="1600" loading="lazy" decoding="async" />
                  <figcaption>{image.caption}</figcaption>
                </figure>
              ))}
            </div>
          </section>
        )}
        <section class="detail-section">
          <h2>Tính năng và trạng thái</h2>
          <ul class="feature-list">
            {project.data.featureProofs.map((feature) => (
              <li class="feature-row">
                <div class="feature-row__top">
                  <h3>{feature.label}</h3>
                  <StatusBadge status={feature.state} />
                </div>
                {feature.limitation && <p>{feature.limitation}</p>}
                <EvidenceList ids={feature.evidenceIds} compact />
              </li>
            ))}
          </ul>
        </section>
        {sourceRefs.length > 0 && (
          <section class="detail-section">
            <h2>Bằng chứng và liên kết</h2>
            <EvidenceList ids={project.data.evidenceIds} />
          </section>
        )}
        {relatedCases.length > 0 && (
          <section class="detail-section">
            <h2>Case study liên quan</h2>
            <div class="grid case-grid">{relatedCases.map((item) => <CaseCard item={item} />)}</div>
          </section>
        )}
      </article>
      <aside class="detail-sidebar" aria-label="Thông tin dự án">
        {project.data.id === 'study2work' && (
          <section class="content-panel study2work-status-panel" aria-labelledby="study2work-status-title">
            <p class="s2w-kicker">Trạng thái · 30/10/2026</p>
            <h2 id="study2work-status-title">Chưa có demo hoặc production</h2>
            <p>Đây là snapshot source và tài liệu công khai. Chưa xác nhận triển khai live hoặc runtime end-to-end.</p>
            <p><strong>develop</strong><br /><code>376054183df9b611c65b14c4e650037b051fb49f</code></p>
            <p><strong>main mặc định</strong><br /><code>bb9e2be2e146285f004cdc00e8d632ca8ed1b4a3</code></p>
            <a class="s2w-repo-link" href="https://github.com/daovanhung-dev/Study2Work" target="_blank" rel="noreferrer">
              Mở mã nguồn Study2Work <span aria-hidden="true">↗</span>
            </a>
          </section>
        )}
        <section class="content-panel">
          <h2>Công nghệ chính</h2>
          <div class="tag-list">{project.data.stack.map((tag) => <span class="tag">{tag}</span>)}</div>
        </section>
        {project.data.repositoryIds.some((id) => id === 'restricted-project') && (
          <section class="content-panel">
            <h2>Phạm vi công khai</h2>
            <p>Trang này tập trung vào cách tiếp cận giao diện và delivery, đồng thời bảo vệ nội dung cá nhân.</p>
          </section>
        )}
        <section class="content-panel">
          <h2>Phạm vi kỹ thuật</h2>
          <ul>{project.data.limitations.map((limitation) => <li>{limitation}</li>)}</ul>
        </section>
      </aside>
    </div>
  </div>
</SiteLayout>
