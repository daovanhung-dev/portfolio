---
import { getCollection } from 'astro:content';
import SiteLayout from '../../components/SiteLayout.astro';
import CaseCard from '../../components/CaseCard.astro';

const cases = (await getCollection('cases')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'vi'));
---

<SiteLayout title="Case study — Đào Văn Hùng" description="Các case study về phân tích vấn đề, lựa chọn kỹ thuật và phát triển phần mềm của Đào Văn Hùng.">
  <div class="page-shell">
    <header class="page-intro">
      <span class="eyebrow">Phân tích công việc</span>
      <h1 class="page-title">Case study</h1>
      <p class="page-lede">Từng case trình bày bối cảnh, ràng buộc, vai trò, cách tiếp cận và phạm vi kết quả để nhà tuyển dụng hiểu rõ quá trình làm việc.</p>
    </header>
    <div class="grid case-grid">
      {cases.map((item) => <CaseCard item={item} />)}
    </div>
  </div>
</SiteLayout>
