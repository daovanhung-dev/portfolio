---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../components/SiteLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import EvidenceList from '../../components/EvidenceList.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { sitePath } from '../../utils/paths';
import { publicEvidenceFor } from '../../utils/evidence';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const projects = (await getCollection('projects')).filter((project) => item.data.projectSlugs.includes(project.id));
const relatedCases = (await getCollection('cases')).filter((other) => item.data.relatedCaseSlugs.includes(other.id));
const publicEvidence = publicEvidenceFor(item.data.evidenceIds);
const sections = [
  ['context', 'Bối cảnh'],
  ['constraints', 'Ràng buộc'],
  ['role', 'Vai trò'],
  ['approach', 'Cách tiếp cận'],
  ['verification', 'Kiểm chứng'],
  ['result', 'Kết quả'],
  ['limitations', 'Phạm vi'],
  ['evidence', 'Mã nguồn'],
];
if (item.data.decisions.length > 0) sections.splice(4, 0, ['decisions', 'Quyết định']);
if (publicEvidence.length === 0) sections.pop();
---

<SiteLayout title={item.data.title + ' — Đào Văn Hùng'} description={item.data.context.slice(0, 155)} route={'/case-studies/' + item.id}>
  <div class="page-shell">
    <header class="detail-header">
      <a class="eyebrow-link" href={sitePath('/case-studies')}>← Tất cả case study</a>
      <span class="eyebrow">Phân tích dự án</span>
      <h1>{item.data.title}</h1>
      <p class="page-lede">{item.data.context}</p>
      <div class="detail-header__meta">
        <span>{item.data.role}</span>
        <StatusBadge status={item.data.status} />
      </div>
    </header>
    <div class="case-layout section">
      <nav class="case-toc" aria-label="Trong case study">
        <h2>Nội dung</h2>
        <ul>{sections.map(([id, label]) => <li><a href={'#' + id}>{label}</a></li>)}</ul>
      </nav>
      <article class="case-content">
        <section id="context"><h2>Bối cảnh</h2><p>{item.data.context}</p></section>
        <section id="constraints"><h2>Ràng buộc</h2><ul>{item.data.constraints.map((constraint) => <li>{constraint}</li>)}</ul></section>
        <section id="role"><h2>Vai trò</h2><p>{item.data.role}.</p></section>
        <section id="approach"><h2>Cách tiếp cận</h2><ol>{item.data.approach.map((step) => <li>{step}</li>)}</ol></section>
        {item.data.decisions.length > 0 && <section id="decisions">
          <h2>Quyết định</h2>
          <ul>{item.data.decisions.map((decision) => <li><strong>{decision.decision}</strong> — {decision.rationale}</li>)}</ul>
        </section>}
        <section id="verification"><h2>Kiểm chứng</h2><p>{item.data.verification}</p></section>
        <section id="result"><h2>Kết quả</h2><p>{item.data.result}</p></section>
        <section id="limitations"><h2>Phạm vi</h2><ul>{item.data.limitations.map((limitation) => <li>{limitation}</li>)}</ul></section>
        {publicEvidence.length > 0 && <section id="evidence">
          <h2>Mã nguồn và tài liệu</h2>
          <EvidenceList ids={item.data.evidenceIds} />
        </section>}
        <div class="prose"><Content /></div>
        {projects.length > 0 && (
          <section><h2>Dự án liên quan</h2><div class="grid project-grid">{projects.map((project) => <ProjectCard project={project} />)}</div></section>
        )}
        {relatedCases.length > 0 && (
          <section><h2>Case liên quan</h2><ul>{relatedCases.map((other) => <li><a href={sitePath('/case-studies/' + other.id)}>{other.data.title}</a></li>)}</ul></section>
        )}
      </article>
    </div>
  </div>
</SiteLayout>
