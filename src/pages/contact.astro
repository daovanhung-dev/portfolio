---
import { getCollection } from 'astro:content';
import SiteLayout from '../components/SiteLayout.astro';

const contacts = await getCollection('contact');
const contact = contacts[0].data;
---

<SiteLayout title="Liên hệ — Đào Văn Hùng" description="Các kênh liên hệ công khai của Đào Văn Hùng.">
  <div class="page-shell">
    <header class="page-intro">
      <span class="eyebrow">Liên hệ</span>
      <h1 class="page-title">Trao đổi về kỹ thuật và công việc</h1>
      <p class="page-lede">Tôi sẵn sàng trao đổi về cơ hội phát triển phần mềm, hợp tác kỹ thuật và các dự án phù hợp.</p>
    </header>
    <section class="contact-card" aria-labelledby="contact-title">
      <div>
        <span class="eyebrow">Kênh liên hệ</span>
        <h2 id="contact-title">Đào Văn Hùng</h2>
        <p>Kết nối với tôi qua email, GitHub hoặc LinkedIn.</p>
      </div>
      <div class="contact-links">
        <a href={'mailto:' + contact.email}>Gửi email <span aria-hidden="true">↗</span></a>
        {contact.links.map((link) => <a href={link.url} target="_blank" rel="noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}
      </div>
    </section>
  </div>
</SiteLayout>
