---
import SiteLayout from '../components/SiteLayout.astro';
import { sitePath } from '../utils/paths';
---

<SiteLayout title="Không tìm thấy trang — Đào Văn Hùng" description="Trang bạn tìm không tồn tại hoặc đã được chuyển." noindex>
  <div class="not-found">
    <span class="not-found__code">404 / NOT FOUND</span>
    <h1>Trang này không có ở đây.</h1>
    <p>Đường dẫn có thể đã thay đổi. Bắt đầu từ trang chủ hoặc xem lại các project hiện có.</p>
    <div class="hero__actions">
      <a class="button button--primary" href={sitePath('/')}>Về trang chủ <span aria-hidden="true">→</span></a>
      <a class="button" href={sitePath('/projects')}>Xem dự án</a>
    </div>
  </div>
</SiteLayout>
