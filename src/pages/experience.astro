---
import { getCollection } from 'astro:content';
import SiteLayout from '../components/SiteLayout.astro';

const experiences = (await getCollection('experiences')).sort((a, b) => a.data.order - b.data.order);
---

<SiteLayout title="Kinh nghiệm — Đào Văn Hùng" description="Lịch sử vai trò, phạm vi công việc và công nghệ liên quan của Đào Văn Hùng.">
  <div class="page-shell">
    <header class="page-intro">
      <span class="eyebrow">Lịch sử công việc</span>
      <h1 class="page-title">Kinh nghiệm</h1>
      <p class="page-lede">Các vị trí, phạm vi công việc và công nghệ tôi đã làm việc cùng.</p>
    </header>
    <ol class="timeline-list" aria-label="Lịch sử kinh nghiệm làm việc">
      {experiences.map((item) => (
        <li class="timeline-entry" data-experience-entry data-experience-id={item.data.id}>
          <time class="timeline-entry__date">{item.data.period}</time>
          <article class="timeline-entry__content">
            <h2>{item.data.organization}</h2>
            <h3>{item.data.role}</h3>
            <p>{item.data.summary}</p>
            {item.data.technologies.length > 0 && (
              <div class="timeline-entry__technologies">
                <p class="timeline-entry__label">Công nghệ liên quan</p>
                <ul class="tag-list" aria-label="Công nghệ liên quan" data-experience-technologies>
                  {item.data.technologies.map((technology) => <li class="tag">{technology}</li>)}
                </ul>
              </div>
            )}
          </article>
        </li>
      ))}
    </ol>
  </div>
</SiteLayout>
