---
import { getCollection } from 'astro:content';
import SiteLayout from '../components/SiteLayout.astro';
import StatusBadge from '../components/StatusBadge.astro';
import EvidenceList from '../components/EvidenceList.astro';
import { sitePath } from '../utils/paths';

const experiences = (await getCollection('experiences')).sort((a, b) => b.data.period.localeCompare(a.data.period, 'vi'));
const projects = await getCollection('projects');
---

<SiteLayout title="Kinh nghiệm — Đào Văn Hùng" description="Dòng thời gian kinh nghiệm và vai trò, kèm attribution và nguồn liên quan.">
  <div class="page-shell">
    <header class="page-intro">
      <span class="eyebrow">Dòng thời gian</span>
      <h1 class="page-title">Kinh nghiệm</h1>
      <p class="page-lede">Vai trò và phạm vi tự xác nhận được ghi riêng với bằng chứng source. Các project liên quan mở trang chi tiết để xem trạng thái và giới hạn.</p>
    </header>
    <ol class="timeline-list">
      {experiences.map((item) => {
        const related = projects.filter((project) => item.data.projectSlugs.includes(project.id));
        return (
          <li class="timeline-entry">
            <time class="timeline-entry__date">{item.data.period}</time>
            <article>
              <h2>{item.data.organization}</h2>
              <h3>{item.data.role}</h3>
              <p>{item.data.summary}</p>
              <div class="timeline-entry__footer">
                <StatusBadge status={item.data.attribution === 'user-attested' ? 'unverified' : 'partial'} />
                {related.map((project) => <a class="text-link" href={sitePath('/projects/' + project.id)}>{project.data.title} <span aria-hidden="true">→</span></a>)}
              </div>
              <EvidenceList ids={item.data.evidenceIds} compact />
            </article>
          </li>
        );
      })}
    </ol>
  </div>
</SiteLayout>
