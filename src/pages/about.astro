---
import { getCollection } from 'astro:content';
import SiteLayout from '../components/SiteLayout.astro';

const [profiles, educationRecords] = await Promise.all([
  getCollection('profile'),
  getCollection('education'),
]);
const profile = profiles[0].data;
const education = educationRecords[0].data;
---

<SiteLayout title="Giới thiệu — Đào Văn Hùng" description="Tìm hiểu về Đào Văn Hùng, kỹ sư phần mềm tập trung vào backend, ứng dụng di động và thiết kế hệ thống.">
  <div class="page-shell">
    <header class="page-intro">
      <span class="eyebrow">Giới thiệu</span>
      <h1 class="page-title">{profile.name}</h1>
      <p class="page-lede">{profile.summary}</p>
    </header>
    <section class="section section--compact">
      <div class="section-heading">
        <div><span class="eyebrow">Nguyên tắc</span><h2>Cách tôi suy nghĩ về kỹ thuật</h2></div>
      </div>
      <ol class="principle-list">
        {profile.principles.map((principle) => (
          <li class="principle-card">
            <span class="eyebrow">{principle.number}</span>
            <h3>{principle.title}</h3>
            <p>{principle.description}</p>
          </li>
        ))}
      </ol>
    </section>
    <section class="section section--compact">
      <div class="section-heading">
        <div><span class="eyebrow">Học vấn</span><h2>{education.institution}</h2></div>
      </div>
      <div class="content-panel">
        <h3>{education.field} · {education.cohort}</h3>
        <p>{education.graduation}</p>
      </div>
    </section>
    <section class="section section--compact">
      <div class="section-heading">
        <div><span class="eyebrow">Quy trình</span><h2>Làm rõ → rà soát → bàn giao</h2></div>
      </div>
      <ol class="workflow-list">{profile.workflow.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{step}</li>)}</ol>
    </section>
  </div>
</SiteLayout>
