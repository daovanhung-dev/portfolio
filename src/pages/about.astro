---
import { getCollection } from 'astro:content';
import SiteLayout from '../components/SiteLayout.astro';
import { siteAsset, sitePath } from '../utils/paths';

const [profiles, educationRecords, projects] = await Promise.all([
  getCollection('profile'),
  getCollection('education'),
  getCollection('projects'),
]);
const profile = profiles[0].data;
const education = educationRecords[0].data;
const projectsBySlug = new Map(projects.map((project) => [project.id, project]));
const aboutProjects = profile.aboutProjectSlugs
  .map((slug) => projectsBySlug.get(slug))
  .filter((project) => project !== undefined);
---

<SiteLayout
  title="Giới thiệu — Đào Văn Hùng · Năng lực Tech Lead"
  description="Kỹ sư phần mềm với kinh nghiệm về kiến trúc hệ thống, backend, dữ liệu, Flutter và AI; có thể dẫn dắt kỹ thuật và theo sát sản phẩm đến kiểm thử, bàn giao."
>
  <div class="page-shell about-page">
    <header class="page-intro page-intro--profile about-hero">
      <div class="page-intro__content about-hero__content">
        <span class="eyebrow">Kỹ sư phần mềm · Năng lực dẫn dắt kỹ thuật</span>
        <h1 class="page-title">{profile.name}</h1>
        <p class="page-lede">{profile.summary}</p>
        <div class="about-hero__actions">
          <a class="button button--primary" href={sitePath('/projects')}>Xem dự án <span aria-hidden="true">→</span></a>
          <a class="button button--quiet" href={sitePath('/contact')}>Liên hệ <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="profile-portrait-frame profile-portrait--about about-hero__portrait">
        <img
          class="profile-portrait"
          src={siteAsset('AVT.jpg')}
          alt="Chân dung Đào Văn Hùng"
          width="960"
          height="958"
          loading="lazy"
          decoding="async"
        />
      </div>
    </header>

    <section class="section section--compact about-projects" aria-labelledby="about-projects-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Năng lực qua sản phẩm</span>
          <h2 id="about-projects-title">Từ kiến trúc đến triển khai đa tầng</h2>
        </div>
        <p>Các dự án cho thấy cách tôi kết nối tư duy hệ thống với việc trực tiếp xây dựng và hoàn thiện sản phẩm.</p>
      </div>
      <div class="about-project-grid">
        {aboutProjects.map((project) => (
          <article class="about-project-card" data-about-project={project.id}>
            <div class="about-project-card__top">
              <span class="eyebrow">{project.data.category}</span>
            </div>
            <h3><a href={sitePath('/projects/' + project.id)}>{project.data.title}<span aria-hidden="true"> ↗</span></a></h3>
            <p class="about-project-card__role">{project.data.role}</p>
            <p class="about-project-card__summary">{project.data.summary}</p>
            <a class="text-link about-project-card__link" href={sitePath('/projects/' + project.id)}>Xem dự án <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </section>

    <section class="section section--compact about-responsibility" aria-labelledby="about-responsibility-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Triết lý làm việc</span>
          <h2 id="about-responsibility-title">Trách nhiệm không dừng ở lúc code chạy</h2>
        </div>
      </div>
      <p class="about-responsibility__statement">{profile.responsibilityStatement}</p>
      <ol class="principle-list about-principle-grid">
        {profile.principles.map((principle) => (
          <li class="principle-card about-principle-card">
            <span class="eyebrow">{principle.number}</span>
            <h3>{principle.title}</h3>
            <p>{principle.description}</p>
          </li>
        ))}
      </ol>
      <ol class="workflow-list about-workflow" aria-label="Quy trình làm việc">
        {profile.workflow.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{step}</li>)}
      </ol>
    </section>

    <section class="about-education" aria-labelledby="about-education-title">
      <div>
        <span class="eyebrow">Học vấn</span>
        <h2 id="about-education-title">{education.field}</h2>
      </div>
      <p>{education.institution} · {education.cohort} · {education.graduation}</p>
    </section>
  </div>
</SiteLayout>
