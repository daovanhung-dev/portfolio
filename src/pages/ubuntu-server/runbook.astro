---
import SiteLayout from '../../components/SiteLayout.astro';
import { sitePath } from '../../utils/paths';
import '../../styles/ubuntu-server.css';

const destination = sitePath('/ubuntu-server');
---

<SiteLayout
  title="Runbook Ubuntu Server đã chuyển trang | Đào Văn Hùng"
  description="Runbook Ubuntu Server hiện được trình bày đầy đủ trên một trang."
  route="/ubuntu-server/runbook"
  noindex={true}
  redirectTo={destination}
  showAudioPlayer={false}
>
  <section class="ubuntu-legacy-redirect" aria-labelledby="ubuntu-legacy-title">
    <p class="eyebrow">Đường dẫn runbook đã được gộp</p>
    <h1 id="ubuntu-legacy-title">Mở runbook Ubuntu Server</h1>
    <p>Nội dung hiện nằm trên một trang. Nếu chưa được chuyển tự động, mở runbook tại đây.</p>
    <p><a class="ubuntu-legacy-redirect__link" href={destination}>Mở runbook production</a></p>
  </section>
</SiteLayout>
