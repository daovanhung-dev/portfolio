---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../components/SiteLayout.astro';
import aliases from '../../data/ubuntuServerAliases.json';
import { sitePath } from '../../utils/paths';
import '../../styles/ubuntu-server.css';

interface LegacyAlias {
  slug: string;
  title: string;
  targetHeading: string;
  notice?: string;
}

export async function getStaticPaths() {
  function normalizeHeading(value: string) {
    return value
      .replace(/[`*_~]/g, '')
      .toLocaleLowerCase('vi')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/đ/g, 'd')
      .replace(/[^a-z0-9]+/g, ' ')
      .trim();
  }

  const entries = await getCollection('ubuntuRunbooks');
  if (entries.length !== 1) throw new Error('Expected exactly one Ubuntu Server v3 runbook source.');
  const { headings } = await render(entries[0]);
  const headingByKey = new Map(headings.map((heading) => [normalizeHeading(heading.text), heading.slug]));

  return (aliases as LegacyAlias[]).map((alias) => {
    const targetSlug = headingByKey.get(normalizeHeading(alias.targetHeading));
    if (!targetSlug) throw new Error(`Ubuntu Server legacy target heading was not found: ${alias.targetHeading}`);
    return { params: { slug: alias.slug }, props: { alias, targetSlug } };
  });
}

const { alias, targetSlug } = Astro.props as { alias: LegacyAlias; targetSlug: string };
const targetUrl = `${sitePath('/ubuntu-server')}?legacy=${encodeURIComponent(alias.slug)}#${targetSlug}`;
---
<SiteLayout
  title={`${alias.title} — Chuyển tới lab Ubuntu Server v3`}
  description={`Liên kết cũ được giữ để mở đúng mục trong runbook Ubuntu Server v3: ${alias.targetHeading}.`}
  route="/ubuntu-server"
  noindex={true}
  redirectTo={targetUrl}
>
  <section class="ubuntu-legacy-redirect" aria-labelledby="ubuntu-legacy-title">
    <p class="eyebrow">Liên kết bài học đã được cập nhật</p>
    <h1 id="ubuntu-legacy-title">{alias.title}</h1>
    <p>Đang mở mục <strong>{alias.targetHeading}</strong> trong lab Ubuntu Server v3.</p>
    {alias.notice && <p class="ubuntu-legacy-redirect__notice">{alias.notice}</p>}
    <p><a class="ubuntu-legacy-redirect__link" href={targetUrl}>Mở mục trong runbook</a></p>
  </section>
</SiteLayout>
