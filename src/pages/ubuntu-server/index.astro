---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../components/SiteLayout.astro';
import aliases from '../../data/ubuntuServerAliases.json';
import { sitePath } from '../../utils/paths';
import '../../styles/ubuntu-server.css';

interface LegacyAlias {
  slug: string;
  targetHeading: string;
  notice?: string;
}

const entries = await getCollection('ubuntuRunbooks');
if (entries.length !== 1) throw new Error('Expected exactly one Ubuntu Server web runbook source.');
const runbook = entries[0];
const { Content, headings } = await render(runbook);
const chapters = headings.filter((heading) => heading.depth === 2 && /^\d{2}\./.test(heading.text));
const subsections = headings.filter((heading) => heading.depth === 3 && /^\d{1,2}\./.test(heading.text));
const legacyNotices = Object.fromEntries(
  (aliases as LegacyAlias[]).filter((alias) => alias.notice).map((alias) => [alias.slug, { notice: alias.notice }]),
);
---

<SiteLayout
  title={runbook.data.title + ' — Runbook production | Đào Văn Hùng'}
  description={runbook.data.description}
  route="/ubuntu-server"
  showAudioPlayer={false}
>
  <div class="ubuntu-page ubuntu-page--runbook ubuntu-page--single-runbook" data-legacy-notices={JSON.stringify(legacyNotices)}>
    <nav class="ubuntu-breadcrumb" aria-label="Đường dẫn">
      <a href={sitePath('/labs')}>Labs</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Ubuntu Server</span>
    </nav>

    <header class="ubuntu-runbook-hero">
      <div class="ubuntu-runbook-hero__copy">
        <p class="eyebrow">INFRASTRUCTURE / DEVOPS · RUNBOOK PRODUCTION V{runbook.data.version}</p>
        <h1 class="ubuntu-runbook-title">{runbook.data.title}</h1>
        <p>{runbook.data.description}</p>
        <p>Biên tập từ tài liệu v3 · Rà soát nội dung: {runbook.data.verified_on}</p>
      </div>
      <dl class="ubuntu-runbook-meta">
        <div><dt>Phạm vi</dt><dd>5 phần · Luồng vận hành</dd></div>
        <div><dt>Trạng thái</dt><dd>Chưa nghiệm thu máy cụ thể</dd></div>
      </dl>
    </header>

    <aside class="ubuntu-runbook-safety" role="note">
      <strong>Trước khi thay đổi</strong>
      <p>Thay IP, domain, user và đường dẫn ví dụ bằng giá trị đã kiểm tra. Giữ console/đường truy cập dự phòng trước khi đổi Netplan, SSH hoặc firewall. Không ghi đè ứng dụng hay dữ liệu đang có.</p>
    </aside>

    <div class="ubuntu-legacy-topic-note" id="ubuntu-legacy-topic-note" role="note" aria-live="polite" hidden>
      <div><strong>Nội dung của URL cũ</strong><p></p></div>
      <a href="#ubuntu-runbook-content">Mở mục liên quan</a>
      <button type="button" aria-label="Ẩn thông báo">Ẩn</button>
    </div>

    <div class="ubuntu-runbook-workspace">
      <aside class="ubuntu-runbook-sidebar" aria-label="Điều hướng runbook">
        <details class="ubuntu-runbook-toc" open>
          <summary><span class="ubuntu-overline">NĂM PHẦN</span><span>{chapters.length} phần</span></summary>
          <nav aria-label="Các phần trong runbook">
            <ol>
              {chapters.map((chapter) => {
                const chapterNumber = chapter.text.match(/^(\d{2})\./)?.[1] ?? '';
                const subsectionPrefix = String(Number(chapterNumber)) + '.';
                const children = subsections.filter((item) => item.text.startsWith(subsectionPrefix));
                return <li>
                  <a class="ubuntu-runbook-toc__chapter" href={'#' + chapter.slug}>{chapter.text}</a>
                  {children.length > 0 && <details class="ubuntu-runbook-toc__subsections">
                    <summary aria-label={'Mở các mục trong ' + chapter.text}>Các thao tác <span aria-hidden="true">+</span></summary>
                    <ol>{children.map((item) => <li><a href={'#' + item.slug}>{item.text}</a></li>)}</ol>
                  </details>}
                </li>;
              })}
            </ol>
          </nav>
        </details>
      </aside>

      <div class="ubuntu-runbook-main">
        <div class="ubuntu-runbook-searchbox">
          <label class="ubuntu-runbook-search">
            <svg viewBox="0 0 24 24" aria-hidden="true" width="19" height="19"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8" fill="none"/><path d="m16 16 5 5" stroke="currentColor" stroke-width="1.8" fill="none"/></svg>
            <input type="search" id="ubuntu-runbook-search" autocomplete="off" placeholder="Tìm lệnh, Netplan, CGNAT, Nginx…" aria-label="Tìm trong runbook Ubuntu Server" aria-controls="ubuntu-runbook-search-results" />
            <kbd>/</kbd>
          </label>
          <span class="ubuntu-runbook-search-status" id="ubuntu-runbook-search-status" aria-live="polite"></span>
          <div class="ubuntu-runbook-search-results" id="ubuntu-runbook-search-results" hidden>
            <p class="ubuntu-overline">KẾT QUẢ TRONG RUNBOOK</p>
            <ol></ol>
          </div>
        </div>
        <article class="ubuntu-runbook-body" id="ubuntu-runbook-content">
          <Content />
        </article>
      </div>
    </div>
  </div>
</SiteLayout>

<script>
  function initUbuntuRunbook() {
    const root = document.querySelector<HTMLElement>('.ubuntu-page--single-runbook');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const article = root.querySelector<HTMLElement>('#ubuntu-runbook-content');
    const search = root.querySelector<HTMLInputElement>('#ubuntu-runbook-search');
    const resultBox = root.querySelector<HTMLElement>('#ubuntu-runbook-search-results');
    const resultList = resultBox?.querySelector<HTMLOListElement>('ol');
    const status = root.querySelector<HTMLElement>('#ubuntu-runbook-search-status');
    if (!article) return;

    const legacyNote = root.querySelector<HTMLElement>('#ubuntu-legacy-topic-note');
    const legacyKey = new URLSearchParams(window.location.search).get('legacy');
    const legacyNotices = JSON.parse(root.dataset.legacyNotices || '{}') as Record<string, { notice: string }>;
    const legacyContent = legacyKey ? legacyNotices[legacyKey] : undefined;
    if (legacyNote && legacyKey) {
      const message = legacyNote.querySelector('p');
      const link = legacyNote.querySelector<HTMLAnchorElement>('a');
      const dismiss = legacyNote.querySelector<HTMLButtonElement>('button');
      if (legacyContent && message) message.textContent = legacyContent.notice;
      else if (message) message.textContent = 'Liên kết này đã được chuyển tới phần gần nhất trong runbook v3.';
      if (link) link.href = window.location.hash || '#ubuntu-runbook-content';
      legacyNote.hidden = false;
      dismiss?.addEventListener('click', () => { legacyNote.hidden = true; });
    }

    const revealHash = () => {
      if (!root.isConnected) return;
      const hash = window.location.hash.slice(1);
      if (!hash) return;
      let target: HTMLElement | null = null;
      try { target = document.getElementById(decodeURIComponent(hash)); } catch { target = null; }
      if (target && article.contains(target)) window.requestAnimationFrame(() => target?.scrollIntoView({ block: 'start' }));
    };
    revealHash();

    const normalize = (value: string) => value.toLocaleLowerCase('vi').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd');
    const articleHeadings = [...article.querySelectorAll<HTMLHeadingElement>('h2, h3, h4')];
    const searchIndex = articleHeadings.map((heading) => {
      const level = Number(heading.tagName.slice(1));
      const parts = [heading.textContent || ''];
      let sibling = heading.nextElementSibling;
      while (sibling) {
        const siblingLevel = /^H([1-6])$/.exec(sibling.tagName);
        if (siblingLevel && Number(siblingLevel[1]) <= level) break;
        parts.push(sibling.textContent || '');
        sibling = sibling.nextElementSibling;
      }
      return { heading, normalized: normalize(parts.join(' ')) };
    });

    const renderSearch = () => {
      if (!search || !resultBox || !resultList || !status) return;
      const term = normalize(search.value.trim());
      resultList.replaceChildren();
      if (!term) {
        resultBox.hidden = true;
        status.textContent = '';
        return;
      }
      const matches = searchIndex.filter((item) => item.normalized.includes(term));
      for (const match of matches.slice(0, 25)) {
        const li = document.createElement('li');
        const link = document.createElement('a');
        link.href = '#' + match.heading.id;
        link.textContent = match.heading.textContent || 'Mục trong runbook';
        li.append(link);
        resultList.append(li);
      }
      resultBox.hidden = false;
      status.textContent = matches.length ? matches.length + ' mục phù hợp' : 'Không tìm thấy nội dung phù hợp';
      if (!matches.length) {
        const li = document.createElement('li');
        li.textContent = 'Thử từ khóa như SSH, CGNAT, systemd hoặc HTTPS.';
        resultList.append(li);
      }
    };

    search?.addEventListener('input', renderSearch);
    resultList?.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a') && search) {
        search.value = '';
        renderSearch();
      }
    });

    if (document.documentElement.dataset.ubuntuRunbookShortcuts !== 'true') {
      document.documentElement.dataset.ubuntuRunbookShortcuts = 'true';
      document.addEventListener('keydown', (event) => {
        const activeRoot = document.querySelector<HTMLElement>('.ubuntu-page--single-runbook');
        const activeSearch = activeRoot?.querySelector<HTMLInputElement>('#ubuntu-runbook-search');
        if (!activeRoot || !activeSearch || event.altKey) return;
        const target = event.target as HTMLElement | null;
        const editing = !!target?.closest('input,textarea,[contenteditable]');
        if (((event.key === '/' && !editing) || ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k'))) {
          event.preventDefault();
          activeSearch.focus();
        }
        if (event.key === 'Escape' && document.activeElement === activeSearch) {
          activeSearch.blur();
          activeSearch.value = '';
          activeRoot.querySelector<HTMLElement>('#ubuntu-runbook-search-results')?.setAttribute('hidden', '');
          activeRoot.querySelector<HTMLElement>('#ubuntu-runbook-search-status')?.replaceChildren();
        }
      });
    }

    article.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((checkbox) => {
      checkbox.disabled = false;
      const listItem = checkbox.closest('li');
      if (listItem && !checkbox.hasAttribute('aria-label')) checkbox.setAttribute('aria-label', 'Đánh dấu: ' + (listItem.textContent || '').trim().slice(0, 180));
    });

    article.querySelectorAll<HTMLElement>('blockquote').forEach((quote) => {
      if (/\[CHANGE\]|DỪNG|RỦI RO|KHÔNG ĐƯỢC|NGUY HIỂM/i.test(quote.textContent || '')) quote.classList.add('ubuntu-runbook-warning');
    });

    article.querySelectorAll<HTMLElement>('pre').forEach((pre) => {
      if (pre.dataset.enhanced === 'true' || pre.closest('.ubuntu-runbook-diagram')) return;
      pre.dataset.enhanced = 'true';
      const code = pre.querySelector('code');
      if (!code) return;
      const language = pre.dataset.language || code.className.match(/language-([\w-]+)/)?.[1] || 'text';
      const contextText = (pre.textContent || '') + ' ' + (pre.previousElementSibling?.textContent || '');
      const context = contextText.match(/\[(SERVER|LAPTOP|ROUTER|DNS)(?:,|\])/i)?.[1]?.toUpperCase();
      const wrapper = document.createElement('div');
      wrapper.className = 'ubuntu-runbook-code';
      const toolbar = document.createElement('div');
      toolbar.className = 'ubuntu-runbook-code__bar';
      const label = document.createElement('span');
      label.textContent = (context ? context + ' · ' : '') + language.toUpperCase();
      const copy = document.createElement('button');
      copy.type = 'button';
      copy.className = 'ubuntu-runbook-copy';
      copy.textContent = 'Sao chép';
      copy.setAttribute('aria-label', 'Sao chép khối mã ' + (context ? context + ' ' : '') + language);
      copy.addEventListener('click', async () => {
        const originalText = copy.textContent;
        try {
          if (!navigator.clipboard?.writeText) throw new Error('Clipboard API unavailable');
          await navigator.clipboard.writeText(code.textContent || '');
          copy.textContent = 'Đã sao chép';
        } catch {
          copy.textContent = 'Không sao chép được';
        }
        window.setTimeout(() => { copy.textContent = originalText || 'Sao chép'; }, 1800);
      });
      toolbar.append(label, copy);
      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.append(toolbar, pre);
    });
  }

  initUbuntuRunbook();
  document.addEventListener('astro:page-load', initUbuntuRunbook);
</script>
